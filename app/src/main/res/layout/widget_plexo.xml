<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon_top"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/widget_icon_desc" />

        <ImageView
            android:id="@+id/widget_icon_bottom"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="-8dp"
            android:contentDescription="@string/widget_icon_desc" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_settings"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/widget_open"
            android:src="@drawable/ic_widget_placeholder"
            android:alpha="0.55" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_empty_title"
        android:textColor="#FFF6F4FF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_empty_sub"
        android:textColor="#FFA7A2C6"
        android:textSize="11sp" />
</LinearLayout>
